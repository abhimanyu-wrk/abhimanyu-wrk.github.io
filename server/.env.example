# Optional configuration for the Node.js/Express Header Inspector backend

# Port and bind host (default: 127.0.0.1:3000)
PORT=3000
HOST=127.0.0.1

# Set TRUST_PROXY=1 when running behind a single trusted reverse proxy such as ngrok.
# Leave as false when exposed directly so X-Forwarded-For cannot be spoofed.
TRUST_PROXY=false

# Optional comma-separated origins allowed to probe GET /api/headers via CORS from static hosting.
# Example: CORS_ORIGIN=https://abhimanyu-wrk.github.io
CORS_ORIGIN=
